{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "bundler",
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "e2e/**/*.ts",
    "e2e/**/*.js",
    "e2e/**/*.svelte",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/build",
    "**/.svelte-kit",
    "examples",
    "storybook-static",
    "test-results",
    "playwright-report"
  ]
}
