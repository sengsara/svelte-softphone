{
  "name": "@sengsara/svelte-softphone",
  "version": "1.0.0",
  "type": "module",
  "description": "A modern, self-contained Svelte 5 softphone component package built on JsSIP for reliable WebRTC/VoIP calling.",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tailwind.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm run build:package && pnpm run build:css",
    "build:package": "svelte-package -i src/lib -o dist",
    "build:css": "tailwindcss -i ./src/lib/tailwind.css -o ./dist/style.css --minify",
    "prepack": "pnpm run build",
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium",
    "test": "pnpm run lint && pnpm run check && pnpm run e2e",
    "publint": "publint"
  },
  "peerDependencies": {
    "jssip": "^3.13.8",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.60.0",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-vitest": "^10.4.2",
    "@storybook/svelte": "^10.4.2",
    "@storybook/svelte-vite": "^10.4.2",
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.9.1",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-storybook": "^10.4.2",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "jssip": "^3.13.8",
    "playwright": "1.60.0",
    "publint": "^0.3.4",
    "storybook": "^10.4.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-eslint-parser": "^1.7.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^5.4.0",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "softphone",
    "voip",
    "webrtc",
    "sip",
    "jssip",
    "softphone-component"
  ]
}
